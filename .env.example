# Kopieren nach .env.local und ausfüllen. Echte Werte nie committen.

# Adresse der Website, z. B. für Sitemap und Vorschaubilder
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktformular (https://resend.com)
RESEND_API_KEY=
# Empfänger der Anfragen
CONTACT_EMAIL_TO=
# Absender, muss bei Resend freigegeben sein
CONTACT_EMAIL_FROM=
